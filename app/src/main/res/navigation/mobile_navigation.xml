<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.student.scheduler.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home"
        xmlns:tools="http://schemas.android.com/tools" />

    <fragment
        android:id="@+id/scheduleFragment"
        android:name="com.student.scheduler.ui.schedule.ScheduleFragment"
        android:label="@string/nav_schedule"
        tools:layout="@layout/fragment_schedule"
        xmlns:tools="http://schemas.android.com/tools" />

    <fragment
        android:id="@+id/tasksFragment"
        android:name="com.student.scheduler.ui.tasks.TasksFragment"
        android:label="@string/nav_tasks"
        tools:layout="@layout/fragment_tasks"
        xmlns:tools="http://schemas.android.com/tools">
        <action
            android:id="@+id/action_tasksFragment_to_taskFormFragment"
            app:destination="@id/taskFormFragment" />
        <action
            android:id="@+id/action_tasksFragment_to_taskDetailFragment"
            app:destination="@id/taskDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/taskDetailFragment"
        android:name="com.student.scheduler.ui.tasks.TaskDetailFragment"
        android:label="Задание"
        tools:layout="@layout/fragment_task_detail"
        xmlns:tools="http://schemas.android.com/tools">
        <argument
            android:name="taskId"
            app:argType="long" />
        <action
            android:id="@+id/action_taskDetailFragment_to_taskFormFragment"
            app:destination="@id/taskFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/taskFormFragment"
        android:name="com.student.scheduler.ui.tasks.TaskFormFragment"
        android:label="Задание"
        tools:layout="@layout/fragment_task_form"
        xmlns:tools="http://schemas.android.com/tools">
        <argument
            android:name="taskId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/statisticsFragment"
        android:name="com.student.scheduler.ui.statistics.StatisticsFragment"
        android:label="@string/nav_statistics"
        tools:layout="@layout/fragment_statistics"
        xmlns:tools="http://schemas.android.com/tools" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.student.scheduler.ui.settings.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings"
        xmlns:tools="http://schemas.android.com/tools" />

</navigation>
